---
import { radio } from '../data/site';
const copyText = `Freq ${radio.frequencyMHz} MHz | BW ${radio.bandwidthKHz} kHz | SF ${radio.spreadingFactor} | CR ${radio.codingRate}`;
---
<section id="settings" class="box-heavy" aria-labelledby="table1">
  <div class="box-head ink"><span id="table1">Table 1 — Cape Town MeshCore radio settings</span><span>Apply on every node</span></div>
  <div class="spec">
    <div><div class="label">Frequency</div><div class="spec-value">{radio.frequencyMHz} <span class="spec-unit">MHz</span></div></div>
    <div><div class="label">Bandwidth</div><div class="spec-value">{radio.bandwidthKHz} <span class="spec-unit">kHz</span></div></div>
    <div><div class="label">Spreading factor</div><div class="spec-value">SF {radio.spreadingFactor}</div></div>
    <div><div class="label">Coding rate</div><div class="spec-value">CR {radio.codingRate}</div></div>
  </div>
  <div class="row" style="align-items: center; justify-content: space-between; padding: 16px 22px">
    {radio.confirmed
      ? <p class="mono" style="margin: 0; font-size: 13px; color: var(--ink-2)">Community preset. Check the wiki for repeater-specific settings.</p>
      : <p class="mono" style="margin: 0; font-size: 13px; color: var(--accent); max-width: 760px">▲ NOTE: community preset still to be agreed. Values must sit inside ICASA's licence-exempt 868 MHz rules.</p>}
    <button type="button" class="btn small" data-copy={copyText} disabled={!radio.confirmed}>Copy settings</button>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        const old = btn.textContent;
        btn.textContent = 'Copied ✓';
        setTimeout(() => (btn.textContent = old), 1600);
      } catch { /* clipboard unavailable */ }
    });
  });
</script>
<style>
  button[disabled] { opacity: .5; cursor: not-allowed; }
</style>
