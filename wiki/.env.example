# Copy to .env on the wiki VM and fill in. Never commit .env.

# Long random password for the Wiki.js database user.
# Generate one with:  openssl rand -base64 32
DB_PASSWORD=

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → your tunnel →
# "Install and run a connector" → copy the long token after --token).
TUNNEL_TOKEN=

# Host port for first-time setup on your LAN (docker-compose.lan.yml only).
# Run preflight.sh first; change this if it says the port is in use.
WIKI_LAN_PORT=3080
