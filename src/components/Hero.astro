---
import { apps } from '../data/site';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-art">
    <svg viewBox="0 0 1200 650" preserveAspectRatio="xMaxYMax slice" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="h-sky" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#0B1626" />
          <stop offset=".35" stop-color="#1E2342" />
          <stop offset=".6" stop-color="#5A3A5C" />
          <stop offset=".78" stop-color="#C96D4C" />
          <stop offset=".86" stop-color="#F2B27A" />
        </linearGradient>
        <linearGradient id="h-sea" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#2A2440" />
          <stop offset="1" stop-color="#0A0F1C" />
        </linearGradient>
        <linearGradient id="h-shade" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#0B1626" stop-opacity=".9" />
          <stop offset=".4" stop-color="#0B1626" stop-opacity=".6" />
          <stop offset=".58" stop-color="#0B1626" stop-opacity="0" />
        </linearGradient>
        <filter id="h-cloud" x="-10%" y="-60%" width="120%" height="220%">
          <feGaussianBlur stdDeviation="7" />
        </filter>
        <filter id="h-soft" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur stdDeviation="1.2" result="b" />
          <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
        </filter>
        <radialGradient id="h-node-glow">
          <stop offset="0" stop-color="#F0FDFF" stop-opacity=".8" />
          <stop offset=".3" stop-color="#8FE3F2" stop-opacity=".3" />
          <stop offset="1" stop-color="#8FE3F2" stop-opacity="0" />
        </radialGradient>
        <g id="h-crystal">
          <path d="M0 -10 L8.7 -5 L8.7 5 L0 10 L-8.7 5 L-8.7 -5 Z" />
          <path d="M0 -10 L-8.7 5 L8.7 5 Z M0 10 L-8.7 -5 L8.7 -5 Z" fill="none" stroke-opacity=".55" />
        </g>
        <pattern id="h-grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M40 0H0V40" fill="none" stroke="#9FD6E6" stroke-opacity=".07" stroke-width="1" />
        </pattern>
      </defs>

      <rect width="1200" height="650" fill="url(#h-sky)" />
      <g fill="#F3F5EF" opacity=".7">
        <circle cx="140" cy="60" r="1.2" /><circle cx="300" cy="34" r="1" /><circle cx="460" cy="90" r="1.3" />
        <circle cx="620" cy="40" r="1" /><circle cx="780" cy="80" r="1.2" /><circle cx="930" cy="30" r="1" />
        <circle cx="1080" cy="74" r="1.3" /><circle cx="1160" cy="140" r="1" /><circle cx="700" cy="150" r=".9" />
        <circle cx="1010" cy="190" r="1" /><circle cx="860" cy="210" r=".9" />
      </g>

      <!-- Table Mountain range, outline traced from a photo taken across Table Bay -->
      <path fill="#3A3256" d="M297.3 542.2 L402.9 529.0 L446.9 520.2 L490.9 507.0 L534.9 482.8 L570.1 454.2 L600.9 435.5 L614.1 423.4 L626.4 421.2 L638.8 422.3 L653.7 430.0 L666.9 443.2 L682.8 449.8 L697.7 454.2 L706.5 449.8 L712.7 432.2 L719.7 426.7 L772.5 425.6 L825.3 424.5 L878.1 424.5 L926.5 423.4 L939.7 426.7 L948.5 431.1 L966.1 442.1 L983.7 454.2 L1010.1 467.4 L1036.5 474.0 L1062.9 472.9 L1098.1 479.5 L1124.5 476.2 L1140.4 467.4 L1152.7 456.4 L1159.7 452.0 L1170.3 452.0 L1177.3 460.8 L1194.9 482.8 L1230.1 503.7 L1282.9 522.4 L1335.7 536.7 L1406.1 544.4 L1406.1 560 L297.3 560 Z" />
      <g stroke="#2A2446" stroke-width="1.6" opacity=".7"><path d="M740 430 L737 451" /><path d="M773 430 L770 451" /><path d="M806 430 L803 451" /><path d="M840 430 L837 451" /><path d="M873 430 L870 451" /><path d="M906 430 L904 451" /></g>
      <!-- Signal Hill, in front of Lion's Head -->
      <path fill="#2F2847" d="M966.1 540.0 L992.5 507.0 L1018.9 489.4 L1049.7 477.3 L1098.1 479.5 L1124.5 489.4 L1150.9 509.2 L1177.3 540.0 L1177.3 560 L966.1 560 Z" />
      <!-- thin tablecloth -->
      <path filter="url(#h-cloud)" fill="#F3F5EF" opacity=".3" d="M728 426 C762 417 884 416 920 425 C894 431 762 432 728 426 Z" />

      <!-- shoreline and Table Bay -->
      <path fill="#1D1830" d="M0 548 L240 542 L480 538 L720 536 L960 538 L1200 540 L1200 558 L0 558 Z" />
      <rect y="556" width="1200" height="94" fill="url(#h-sea)" />
      <g stroke="#F2B27A" stroke-opacity=".3" stroke-width="1.5">
        <path d="M880 574 H1060" /><path d="M912 590 H1028" /><path d="M940 606 H1000" />
      </g>

      <!-- mesh: 3 repeaters on the peaks, 9 companions below; every node linked -->
      <g stroke="#A8F0FF" fill="none" stroke-linecap="round">
        <!-- brighter: large-large and each small node's link to its nearest large node -->
        <g stroke-width="5" stroke-opacity=".07"><path d="M626.4 421.2 L926.5 423.4" /><path d="M926.5 423.4 L1165.0 452.0" /><path d="M575 562 L626.4 421.2" /><path d="M648 598 L626.4 421.2" /><path d="M722 570 L626.4 421.2" /><path d="M796 608 L926.5 423.4" /><path d="M868 576 L926.5 423.4" /><path d="M944 604 L926.5 423.4" /><path d="M1022 566 L926.5 423.4" /><path d="M1098 598 L1165.0 452.0" /><path d="M1172 580 L1165.0 452.0" /></g>
        <g stroke-width="1" stroke-opacity=".6" filter="url(#h-soft)"><path d="M626.4 421.2 L926.5 423.4" /><path d="M926.5 423.4 L1165.0 452.0" /><path d="M575 562 L626.4 421.2" /><path d="M648 598 L626.4 421.2" /><path d="M722 570 L626.4 421.2" /><path d="M796 608 L926.5 423.4" /><path d="M868 576 L926.5 423.4" /><path d="M944 604 L926.5 423.4" /><path d="M1022 566 L926.5 423.4" /><path d="M1098 598 L1165.0 452.0" /><path d="M1172 580 L1165.0 452.0" /></g>
        <!-- faint: other large-small links and all links between small nodes -->
        <g stroke-width=".8" stroke-opacity=".2"><path d="M626.4 421.2 L1165.0 452.0" /><path d="M575 562 L926.5 423.4" /><path d="M575 562 L1165.0 452.0" /><path d="M648 598 L926.5 423.4" /><path d="M648 598 L1165.0 452.0" /><path d="M722 570 L926.5 423.4" /><path d="M722 570 L1165.0 452.0" /><path d="M796 608 L626.4 421.2" /><path d="M796 608 L1165.0 452.0" /><path d="M868 576 L626.4 421.2" /><path d="M868 576 L1165.0 452.0" /><path d="M944 604 L626.4 421.2" /><path d="M944 604 L1165.0 452.0" /><path d="M1022 566 L626.4 421.2" /><path d="M1022 566 L1165.0 452.0" /><path d="M1098 598 L626.4 421.2" /><path d="M1098 598 L926.5 423.4" /><path d="M1172 580 L626.4 421.2" /><path d="M1172 580 L926.5 423.4" /><path d="M575 562 L648 598" /><path d="M648 598 L722 570" /><path d="M722 570 L796 608" /><path d="M796 608 L868 576" /><path d="M868 576 L944 604" /><path d="M944 604 L1022 566" /><path d="M1022 566 L1098 598" /><path d="M1098 598 L1172 580" /><path d="M575 562 L722 570" /><path d="M648 598 L796 608" /><path d="M722 570 L868 576" /><path d="M796 608 L944 604" /><path d="M868 576 L1022 566" /><path d="M944 604 L1098 598" /><path d="M1022 566 L1172 580" /><path d="M1172 580 L1240 640" /><path d="M1165.0 452.0 L1240 560" /></g>
      </g>
      <!-- nodes: brightness varies per node on purpose -->
      <g fill="url(#h-node-glow)"><circle cx="626.4" cy="421.2" r="28" opacity="0.6" /><circle cx="926.5" cy="423.4" r="36" opacity="1.0" /><circle cx="1165.0" cy="452.0" r="23" opacity="0.35" /><circle cx="575" cy="562" r="17" opacity="0.85" /><circle cx="648" cy="598" r="11" opacity="0.25" /><circle cx="722" cy="570" r="18" opacity="1.0" /><circle cx="796" cy="608" r="13" opacity="0.5" /><circle cx="868" cy="576" r="11" opacity="0.3" /><circle cx="944" cy="604" r="18" opacity="0.95" /><circle cx="1022" cy="566" r="12" opacity="0.4" /><circle cx="1098" cy="598" r="18" opacity="1.0" /><circle cx="1172" cy="580" r="14" opacity="0.6" /></g>
      <g fill="rgba(190, 245, 255, .1)" stroke="#C8F7FF" stroke-width=".9" stroke-opacity=".85" filter="url(#h-soft)"><use href="#h-crystal" transform="translate(626.4 421.2)" opacity="0.72" /><use href="#h-crystal" transform="translate(926.5 423.4)" opacity="1.0" /><use href="#h-crystal" transform="translate(1165.0 452.0)" opacity="0.54" /><use href="#h-crystal" transform="translate(575 562) scale(0.55)" opacity="0.9" /><use href="#h-crystal" transform="translate(648 598) scale(0.55)" opacity="0.47" /><use href="#h-crystal" transform="translate(722 570) scale(0.55)" opacity="1.0" /><use href="#h-crystal" transform="translate(796 608) scale(0.55)" opacity="0.65" /><use href="#h-crystal" transform="translate(868 576) scale(0.55)" opacity="0.51" /><use href="#h-crystal" transform="translate(944 604) scale(0.55)" opacity="0.96" /><use href="#h-crystal" transform="translate(1022 566) scale(0.55)" opacity="0.58" /><use href="#h-crystal" transform="translate(1098 598) scale(0.55)" opacity="1.0" /><use href="#h-crystal" transform="translate(1172 580) scale(0.55)" opacity="0.72" /></g>
      <g fill="#FFFFFF" filter="url(#h-soft)"><circle cx="626.4" cy="421.2" r="1.7" opacity="0.74" /><circle cx="926.5" cy="423.4" r="2.2" opacity="1.0" /><circle cx="1165.0" cy="452.0" r="1.4" opacity="0.58" /><circle cx="575" cy="562" r="2.0" opacity="0.9" /><circle cx="648" cy="598" r="1.3" opacity="0.51" /><circle cx="722" cy="570" r="2.2" opacity="1.0" /><circle cx="796" cy="608" r="1.6" opacity="0.68" /><circle cx="868" cy="576" r="1.4" opacity="0.54" /><circle cx="944" cy="604" r="2.1" opacity="0.97" /><circle cx="1022" cy="566" r="1.5" opacity="0.61" /><circle cx="1098" cy="598" r="2.2" opacity="1.0" /><circle cx="1172" cy="580" r="1.7" opacity="0.74" /></g>

      <rect width="1200" height="650" fill="url(#h-grid)" />
      <rect width="1200" height="650" fill="url(#h-shade)" />
    </svg>
  </div>

  <div class="hero-body">
    <h1 id="hero-title" class="hero-title">MeshCore Cape Town</h1>
    <div class="hero-apps">
      <a class="store" href={apps.android} rel="noopener">
        <svg width="20" height="22" viewBox="0 0 20 22" aria-hidden="true"><path d="M2 1.5v19l16-9.5z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg>
        <span><small>Get it on</small>Google Play</span>
      </a>
      <a class="store" href={apps.ios} rel="noopener">
        <svg width="18" height="24" viewBox="0 0 18 24" aria-hidden="true"><rect x="2" y="1" width="14" height="22" rx="3" fill="none" stroke="currentColor" stroke-width="2" /><path d="M7 19h4" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        <span><small>Download on the</small>App Store</span>
      </a>
    </div>
    <p class="hero-lead">MeshCore is a simple, secure, off-grid mesh communications system.</p>
    <ul class="hero-list">
      <li>Works without internet or cell networks — even during load-shedding.</li>
      <li>Licence-free in South Africa, classified by ICASA as exempt short&#8209;range devices.</li>
      <li>Community driven and not centrally organised, everybody can join.</li>
      <li>A fast-growing active community.</li>
    </ul>
  </div>

</section>

<style>
  /* Hero card: full content width (1200px), 470px tall like meshcore.ch, 24px rounded corners */
  .hero { position: relative; overflow: hidden; color: #F3F5EF; background: #0B1626; display: flex; flex-direction: column; min-height: 470px; border-radius: 24px; box-shadow: 0 12px 32px rgba(17, 24, 39, .18); }
  /* pull the next section up so the gap below the hero matches the gap above it (40px desktop, 24px mobile) */
  .hero { margin-bottom: -32px; }
  .hero-art { position: absolute; inset: 0; }
  .hero-art svg { width: 100%; height: 100%; display: block; }
  /* title padding: visible gap above the title equals the gap to its left (and, on phones, the gap below it) */
  .hero-body { position: relative; flex: 1 1 auto; padding: 45px 48px 40px; display: flex; flex-direction: column; gap: 16px; max-width: 620px; }
  .hero-title { font-family: var(--cond); font-weight: 700; font-size: 56px; line-height: 1; letter-spacing: -.01em; margin: 0; white-space: nowrap; text-shadow: 0 2px 18px rgba(11, 22, 38, .6); }
  .hero-apps { display: flex; flex-wrap: wrap; gap: 14px; padding: 6px 0 14px; }
  .store {
    display: inline-flex; align-items: center; gap: 12px; min-height: 48px; padding: 0 16px; border-radius: 10px;
    color: #F3F5EF; text-decoration: none; background: rgba(11, 22, 38, .72);
    border: 1.5px solid #F3F5EF; font-family: var(--cond); font-size: 19px; font-weight: 600; line-height: 1.05;
  }
  .store small { display: block; font-family: var(--mono); font-size: 11px; font-weight: 400; letter-spacing: .06em; }
  .store:hover { background: #F3F5EF; color: #0B1626; }
  .hero-lead { margin: 0; font-size: 16px; font-weight: 500; text-shadow: 0 1px 10px rgba(11, 22, 38, .8); }
  .hero-list { margin: 0; padding-left: 22px; display: flex; flex-direction: column; gap: 4px; font-size: 16px; text-shadow: 0 1px 10px rgba(11, 22, 38, .8); }
  .hero-list li::marker { color: #8FE3F2; }
  @media (max-width: 760px) {
    .hero { min-height: 0; border-radius: 18px; }
    .hero-body { order: 1; padding: 18px 20px 24px; }
    .hero-title { font-size: 32px; }
    .hero-art { position: relative; inset: auto; order: 2; aspect-ratio: 1200 / 650; overflow: hidden; }
    .hero-art svg { transform: scale(1.75); transform-origin: 100% 88%; }
    .hero-art .labels { display: none; }
  }
</style>
