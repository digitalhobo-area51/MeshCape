---
import { apps } from '../data/site';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-art">
    <svg viewBox="0 0 1200 650" preserveAspectRatio="xMaxYMax slice" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="h-sky" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#2E2A52" />
          <stop offset=".3" stop-color="#5E4C82" />
          <stop offset=".55" stop-color="#B77AA6" />
          <stop offset=".72" stop-color="#E79AAE" />
          <stop offset=".84" stop-color="#F4B394" />
          <stop offset=".9" stop-color="#F7C890" />
        </linearGradient>
        <radialGradient id="h-sun" cx="1080" cy="500" r="420" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="#FFD9A0" stop-opacity=".85" />
          <stop offset=".4" stop-color="#F5A98E" stop-opacity=".35" />
          <stop offset="1" stop-color="#F5A98E" stop-opacity="0" />
        </radialGradient>
        <linearGradient id="h-mtn" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#8E6E98" />
          <stop offset=".6" stop-color="#76597F" />
          <stop offset="1" stop-color="#5E4768" />
        </linearGradient>
        <linearGradient id="h-shade" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#1F1830" stop-opacity=".88" />
          <stop offset=".38" stop-color="#1F1830" stop-opacity=".55" />
          <stop offset=".58" stop-color="#1F1830" stop-opacity="0" />
        </linearGradient>
        <filter id="h-streak" x="-20%" y="-200%" width="140%" height="500%">
          <feGaussianBlur stdDeviation="5 2.5" />
        </filter>
        <filter id="h-cloud" x="-10%" y="-60%" width="120%" height="220%">
          <feGaussianBlur stdDeviation="7" />
        </filter>
        <filter id="h-soft" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur stdDeviation="1.2" result="b" />
          <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
        </filter>
        <radialGradient id="h-node-glow">
          <stop offset="0" stop-color="#F0FDFF" stop-opacity=".8" />
          <stop offset=".3" stop-color="#8FE3F2" stop-opacity=".3" />
          <stop offset="1" stop-color="#8FE3F2" stop-opacity="0" />
        </radialGradient>
        <g id="h-crystal">
          <path d="M0 -10 L8.7 -5 L8.7 5 L0 10 L-8.7 5 L-8.7 -5 Z" />
          <path d="M0 -10 L-8.7 5 L8.7 5 Z M0 10 L-8.7 -5 L8.7 -5 Z" fill="none" stroke-opacity=".55" />
        </g>
        <pattern id="h-grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M40 0H0V40" fill="none" stroke="#FFFFFF" stroke-opacity=".05" stroke-width="1" />
        </pattern>
      </defs>

      <rect width="1200" height="650" fill="url(#h-sky)" />
      <rect width="1200" height="650" fill="url(#h-sun)" />
      <!-- painted cloud streaks -->
      <g filter="url(#h-streak)">
        <g fill="#7E64A0" opacity=".55">
          <path d="M80 120 C260 96 480 104 640 122 C500 138 300 140 80 120 Z" />
          <path d="M520 70 C700 52 900 58 1080 76 C900 92 700 90 520 70 Z" />
          <path d="M780 168 C920 154 1080 158 1200 170 L1200 188 C1060 184 900 186 780 168 Z" />
        </g>
        <g fill="#F2B3C8" opacity=".6">
          <path d="M140 210 C330 190 560 196 760 214 C560 232 330 232 140 210 Z" />
          <path d="M640 250 C820 232 1010 238 1200 252 L1200 270 C1010 272 820 270 640 250 Z" />
          <path d="M40 300 C200 286 380 290 520 302 C380 316 200 316 40 300 Z" />
        </g>
        <g fill="#FFD2B0" opacity=".55">
          <path d="M700 320 C860 306 1040 310 1200 322 L1200 338 C1040 340 860 338 700 320 Z" />
          <path d="M360 350 C500 340 640 342 760 352 C640 364 500 364 360 350 Z" />
        </g>
      </g>

      <!-- land in front of the mountain (layered, flat colour) -->
      <path fill="#5B4569" d="M0 540 C160 528 330 520 500 522 C680 524 840 514 1000 516 C1100 517 1160 520 1200 522 L1200 650 L0 650 Z" />
      <path fill="#46344F" d="M0 572 C140 560 300 556 460 564 C640 572 800 558 960 560 C1080 562 1150 566 1200 570 L1200 650 L0 650 Z" />
      <path fill="#33263C" d="M0 610 C180 596 380 598 560 606 C760 614 940 600 1200 604 L1200 650 L0 650 Z" />
      <g fill="#FFD68A" opacity=".55">
        <circle cx="520" cy="530" r="1.3" /><circle cx="610" cy="527" r="1.1" /><circle cx="880" cy="524" r="1.3" />
        <circle cx="1040" cy="527" r="1.1" /><circle cx="1130" cy="530" r="1.3" />
      </g>

      <!-- far range: Devil's Peak, Table Mountain, Lion's Head, Signal Hill -->
      <g transform="translate(302.5 105) scale(.75)">
        <path fill="url(#h-mtn)" d="M-420 580 L0 566 L264 553 L290 547 L333 530 L452 490 L455 486 L494 448 L520 409 L538 393 L550 396 L563 414 L584 434 L607 438 L624 408 L638 378 L654 367 L685 364 L810 363 L904 363 L929 370 L946 384 L966 418 L989 452 L1011 478 L1028 481 L1044 461 L1058 434 L1075 416 L1092 411 L1110 417 L1124 437 L1136 466 L1153 487 L1200 498 L1200 580 L-420 580 Z" />
        <g stroke="#6A4F74" stroke-width="1.6" opacity=".7">
        <path d="M670 375 L664 428" /><path d="M709 372 L706 418" /><path d="M756 371 L749 430" />
        <path d="M802 371 L799 413" /><path d="M849 372 L843 425" /><path d="M896 373 L893 412" />
      </g>
        <path filter="url(#h-cloud)" fill="#FCE3EC" opacity=".6" d="M645 376 C670 357 732 351 794 354 C857 351 911 356 939 377 C927 389 903 400 897 418 C880 401 857 395 833 401 C802 390 763 395 732 407 C709 393 670 390 645 376 Z" />
      </g>

      <!-- mesh: soft glowing links and crystal nodes on the peaks, city and a boat -->
      <g stroke="#A8F0FF" fill="none" stroke-linecap="round">
        <g stroke-width="5" stroke-opacity=".08"><path d="M711 405 L798 386" /><path d="M798 386 L986 383" /><path d="M986 383 L1127 419" /><path d="M1127 419 L1173 471" /><path d="M711 405 L700 518" /><path d="M798 386 L820 516" /><path d="M986 383 L960 518" /><path d="M1127 419 L1090 522" /><path d="M1173 471 L1160 525" /><path d="M960 518 L950 582" /></g>
        <g stroke-width="1" stroke-opacity=".6" filter="url(#h-soft)"><path d="M711 405 L798 386" /><path d="M798 386 L986 383" /><path d="M986 383 L1127 419" /><path d="M1127 419 L1173 471" /><path d="M711 405 L700 518" /><path d="M798 386 L820 516" /><path d="M986 383 L960 518" /><path d="M1127 419 L1090 522" /><path d="M1173 471 L1160 525" /><path d="M960 518 L950 582" /></g>
        <g stroke-width=".8" stroke-opacity=".22"><path d="M711 405 L986 383" /><path d="M798 386 L1127 419" /><path d="M820 516 L960 518" /><path d="M960 518 L1090 522" /><path d="M798 386 L640 210" /><path d="M986 383 L1230 250" /><path d="M1127 419 L1240 600" /><path d="M950 582 L1240 640" /><path d="M711 405 L600 560" /></g>
      </g>
      <g fill="url(#h-node-glow)"><circle cx="711" cy="405" r="30" /><circle cx="798" cy="386" r="30" /><circle cx="986" cy="383" r="30" /><circle cx="1127" cy="419" r="30" /><circle cx="1173" cy="471" r="30" /><circle cx="700" cy="518" r="15" /><circle cx="820" cy="516" r="15" /><circle cx="960" cy="518" r="15" /><circle cx="1090" cy="522" r="15" /><circle cx="1160" cy="525" r="15" /><circle cx="950" cy="582" r="15" /></g>
      <g fill="rgba(190, 245, 255, .1)" stroke="#C8F7FF" stroke-width=".9" stroke-opacity=".85" filter="url(#h-soft)"><use href="#h-crystal" transform="translate(711 405)" /><use href="#h-crystal" transform="translate(798 386)" /><use href="#h-crystal" transform="translate(986 383)" /><use href="#h-crystal" transform="translate(1127 419)" /><use href="#h-crystal" transform="translate(1173 471)" /><use href="#h-crystal" transform="translate(700 518) scale(.55)" /><use href="#h-crystal" transform="translate(820 516) scale(.55)" /><use href="#h-crystal" transform="translate(960 518) scale(.55)" /><use href="#h-crystal" transform="translate(1090 522) scale(.55)" /><use href="#h-crystal" transform="translate(1160 525) scale(.55)" /><use href="#h-crystal" transform="translate(950 582) scale(.55)" /></g>
      <g fill="#FFFFFF" filter="url(#h-soft)"><circle cx="711" cy="405" r="1.8" /><circle cx="798" cy="386" r="1.8" /><circle cx="986" cy="383" r="1.8" /><circle cx="1127" cy="419" r="1.8" /><circle cx="1173" cy="471" r="1.8" /><circle cx="700" cy="518" r="1.8" /><circle cx="820" cy="516" r="1.8" /><circle cx="960" cy="518" r="1.8" /><circle cx="1090" cy="522" r="1.8" /><circle cx="1160" cy="525" r="1.8" /><circle cx="950" cy="582" r="1.8" /></g>

      <rect width="1200" height="650" fill="url(#h-grid)" />
      <rect width="1200" height="650" fill="url(#h-shade)" />
    </svg>
  </div>

  <div class="hero-body">
    <h1 id="hero-title" class="hero-title">MeshCore Cape Town</h1>
    <div class="hero-apps">
      <a class="store" href={apps.android} rel="noopener">
        <svg width="20" height="22" viewBox="0 0 20 22" aria-hidden="true"><path d="M2 1.5v19l16-9.5z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg>
        <span><small>Get it on</small>Google Play</span>
      </a>
      <a class="store" href={apps.ios} rel="noopener">
        <svg width="18" height="24" viewBox="0 0 18 24" aria-hidden="true"><rect x="2" y="1" width="14" height="22" rx="3" fill="none" stroke="currentColor" stroke-width="2" /><path d="M7 19h4" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        <span><small>Download on the</small>App Store</span>
      </a>
    </div>
    <p class="hero-lead">MeshCore is a simple, secure, off-grid text-messaging mesh:</p>
    <ul class="hero-list">
      <li>Works without internet or cell networks — even during load-shedding.</li>
      <li>Licence-free in South Africa on ICASA's 868 MHz ISM band.</li>
      <li>Community driven and not centrally organised — anyone can join.</li>
      <li>A fast-growing alternative to Meshtastic, with an active community.</li>
    </ul>
  </div>

</section>

<style>
  /* Hero card: full content width (1200px), 470px tall like meshcore.ch, 24px rounded corners */
  .hero { position: relative; overflow: hidden; color: #F3F5EF; background: #241B33; display: flex; flex-direction: column; min-height: 470px; border-radius: 24px; box-shadow: 0 12px 32px rgba(17, 24, 39, .18); }
  .hero-art { position: absolute; inset: 0; }
  .hero-art svg { width: 100%; height: 100%; display: block; }
  .hero-body { position: relative; flex: 1 1 auto; padding: 52px 48px 40px; display: flex; flex-direction: column; gap: 16px; max-width: 620px; }
  .hero-title { font-family: var(--cond); font-weight: 700; font-size: 56px; line-height: 1; letter-spacing: -.01em; margin: 0; white-space: nowrap; text-shadow: 0 2px 18px rgba(31, 24, 48, .6); }
  .hero-apps { display: flex; flex-wrap: wrap; gap: 14px; padding: 6px 0 14px; }
  .store {
    display: inline-flex; align-items: center; gap: 12px; min-height: 48px; padding: 0 16px; border-radius: 10px;
    color: #F3F5EF; text-decoration: none; background: rgba(31, 24, 48, .6);
    border: 1.5px solid #F3F5EF; font-family: var(--cond); font-size: 19px; font-weight: 600; line-height: 1.05;
  }
  .store small { display: block; font-family: var(--mono); font-size: 11px; font-weight: 400; letter-spacing: .06em; }
  .store:hover { background: #F3F5EF; color: #241B33; }
  .hero-lead { margin: 0; font-size: 16px; font-weight: 500; text-shadow: 0 1px 10px rgba(31, 24, 48, .8); }
  .hero-list { margin: 0; padding-left: 22px; display: flex; flex-direction: column; gap: 4px; font-size: 16px; text-shadow: 0 1px 10px rgba(31, 24, 48, .8); }
  .hero-list li::marker { color: #8FE3F2; }
  @media (max-width: 760px) {
    .hero { min-height: 0; border-radius: 18px; }
    .hero-body { order: 1; padding: 28px 20px 24px; }
    .hero-title { font-size: 32px; }
    .hero-art { position: relative; inset: auto; order: 2; aspect-ratio: 1200 / 650; overflow: hidden; }
    .hero-art svg { transform: scale(1.75); transform-origin: 100% 88%; }
    .hero-art .labels { display: none; }
  }
</style>
