---
import { radio } from '../data/site';
---
<section id="settings" class="box-heavy radio-card" aria-labelledby="table1">
  <div class="box-head ink"><span id="table1">South African MeshCore radio settings</span><span>App preset: {radio.appPreset}</span></div>
  <div class="spec">
    <div><div class="label">Frequency</div><div class="spec-value">{radio.frequencyMHz} <span class="spec-unit">MHz</span></div></div>
    <div><div class="label">Bandwidth</div><div class="spec-value">{radio.bandwidthKHz} <span class="spec-unit">kHz</span></div></div>
    <div><div class="label">Spreading factor</div><div class="spec-value">SF {radio.spreadingFactor}</div></div>
    <div><div class="label">Coding rate</div><div class="spec-value">CR {radio.codingRate} <span class="spec-unit">({radio.codingRateRatio})</span></div></div>
    <div><div class="label">Duty cycle</div><div class="spec-value">{radio.dutyCycle}</div></div>
  </div>
</section>
<style>
  /* Rounded card to match the hero; the outer border comes from .box-heavy */
  .radio-card { border-radius: 24px; overflow: hidden; }
  /* Cells draw only top/left dividers; the -1px offset tucks the left edge under the card border,
     so there is no doubled line along the bottom, even when cells wrap onto several rows */
  .radio-card .spec { margin: 0 0 0 -1px; }
  .radio-card .spec > div { border-right: none; border-bottom: none; border-left: 1px solid var(--ink); border-top: 1px solid var(--ink); }
  @media (max-width: 760px) {
    .radio-card { border-radius: 18px; }
    /* two columns on phones; the odd last cell spans the row so its top line runs full width */
    .radio-card .spec { grid-template-columns: 1fr 1fr; }
    .radio-card .spec > div:last-child:nth-child(odd) { grid-column: 1 / -1; }
  }
</style>
