// Cloudflare Workers config — static site only (no server code).
// `npm run build` writes the site to ./dist; `wrangler deploy` uploads it.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meshcape",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": true,
  "preview_urls": true
}
