---
// Three equal content panels under the radio table: icon, title, short description.
const mapUrl = 'https://map.meshcore.io/?lat=-33.5379&lon=19.2532&zoom=8';
---
<section class="panels" aria-label="Highlights">
  <a class="panel panel-link" href="https://meshcore.io/" target="_blank" rel="noopener">
    <!-- globe -->
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z" /></svg>
    <h2 class="panel-title">Official MeshCore Site</h2>
    <p class="panel-body">The global home of MeshCore, with the official apps, firmware and documentation.</p>
  </a>

  <article class="panel">
    <!-- people -->
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="9" cy="8" r="3.5" /><path d="M2.5 20c.6-3.6 3.2-5.5 6.5-5.5s5.9 1.9 6.5 5.5" /><path d="M15.5 4.8a3.5 3.5 0 0 1 0 6.4M17.5 14.8c2.2.6 3.6 2.3 4 5.2" /></svg>
    <h2 class="panel-title">Local Community Site</h2>
    <p class="panel-body">Engage with the local community and share experiences in the mesh.</p>
  </article>

  <a class="panel panel-link" href={mapUrl} target="_blank" rel="noopener">
    <!-- folded map with pin -->
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2Z" /><path d="M9 4v14M15 6v14" /></svg>
    <h2 class="panel-title">Dynamic Mesh Map</h2>
    <p class="panel-body">Official MeshCore map showing nodes in the area.</p>
  </a>
</section>
<style>
  /* Same gap above as between the hero and the table (40px desktop, 24px phone), and the same gap between panels.
     The page stack puts 72px / 56px between sections, so pull up by 32px. */
  .panels { margin-top: -32px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }

  /* Uniform feature cards: icon, bold title, muted description */
  .panel {
    background: var(--ink); color: var(--paper); border: 1px solid rgba(243, 245, 239, .08); border-radius: 24px;
    padding: 32px; display: flex; flex-direction: column; text-decoration: none;
  }
  .icon { width: 34px; height: 34px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; margin-bottom: 26px; }
  .panel-title { font-family: var(--sans); font-size: 22px; font-weight: 600; line-height: 1.25; margin: 0 0 12px; }
  .panel-body { margin: 0; font-size: 16px; line-height: 1.55; color: #A9B6BD; }

  /* Whole-box links: lift and lighten on hover / keyboard focus */
  .panel-link { transition: background .15s ease, transform .15s ease, box-shadow .15s ease; }
  .panel-link:hover, .panel-link:focus-visible { color: var(--paper); background: #24363F; transform: translateY(-3px); box-shadow: 0 12px 32px rgba(17, 24, 39, .22); }
  .panel-link:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }

  @media (prefers-reduced-motion: reduce) { .panel-link { transition: none; } .panel-link:hover, .panel-link:focus-visible { transform: none; } }
  @media (max-width: 760px) {
    .panels { grid-template-columns: 1fr; gap: 24px; }
    .panel { border-radius: 18px; padding: 24px 20px; }
    .icon { width: 30px; height: 30px; margin-bottom: 18px; }
  }
</style>
