---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="box-heavy" style="padding: 40px; display: flex; flex-direction: column; gap: 16px">
    <div class="kicker">Error 404 — no route to host</div>
    <h1 class="h1">This packet never arrived.</h1>
    <p class="muted" style="margin: 0">The page you're after isn't on this sheet.</p>
    <a class="btn ink" href="/" style="align-self: flex-start">Back to home →</a>
  </section>
</Base>
